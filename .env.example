# Database (acessada apenas pela rede interna do Docker — nenhuma porta publicada no host)
# DB_HOST = nome do serviço no docker-compose; a porta interna do Postgres é sempre 5432.
DB_HOST=db
DB_NAME=quiteup
DB_USER=quiteup_user
DB_PASSWORD=changeme

# RabbitMQ (acessado apenas pela rede interna do Docker — nenhuma porta publicada no host)
# RABBITMQ_HOST = nome do serviço no docker-compose; RABBITMQ_PORT é a porta interna (5672).
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=quiteup
RABBITMQ_PASSWORD=changeme

# JWT
JWT_SECRET=your-super-secret-key-at-least-32-characters!!
JWT_ISSUER=quite-up
JWT_AUDIENCE=quite-up-client
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# Hashids
HASHIDS_SALT=your-hashids-salt-change-this
HASHIDS_MIN_LENGTH=8

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_FROM_NAME=Quite-Up
SMTP_FROM_EMAIL=noreply@example.com

# URL publica do frontend — origem do CORS da API e base dos links gerados pela API.
# Precisa ser EXATAMENTE https://<dominio-real-do-quite-up> (mesma origem que o browser usa).
#
# IMPORTANTE (arquitetura com Caddy compartilhado):
#   - O Caddy proprio deste projeto foi desativado. Quem roteia o dominio e emite o
#     certificado HTTPS (Let's Encrypt) e o Caddy do ExactLab, na MESMA VPS.
#   - O dominio e definido no .env de producao do ExactLab, como DOMAIN_QUITE_UP.
#   - O DNS desse dominio deve apontar (registro A) para o MESMO IP publico da VPS.
APP_URL=https://app.exemplo.com.br
